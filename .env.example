# 应用配置
APP_ENV=development
APP_NAME=EvidenceDesk Agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL 配置
POSTGRES_USER=evidence_desk
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=evidence_desk
POSTGRES_PORT=5433
DATABASE_URL=postgresql://evidence_desk:replace_with_a_local_password@127.0.0.1:5433/evidence_desk

# Weaviate 配置
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_URL=http://127.0.0.1:8081

# GitHub API 配置（GitHub Tool 阶段之前保持 Token 为空）
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=

# RAG Baseline（这里只登记配置，阶段 0C 不下载模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型文件会下载到项目根目录的此路径；该目录已被 Git 忽略。
EMBEDDING_CACHE_DIR=.cache/huggingface
RETRIEVAL_TOP_K=5

# 回答生成（OpenAI 或兼容 OpenAI 协议的中转站）
# 真实值只写进本地 .env（已被 Git 忽略），不要写进 .env.example。
OPENAI_API_KEY=
# 中转站在这里填它给你的 Base URL，例如 https://your-relay.example.com/v1
# 用 OpenAI 官方服务则整行留空或删除。
OPENAI_BASE_URL=
ANSWER_MODEL=gpt-4o-mini
ANSWER_TEMPERATURE=0

# ReAct Agent 多轮记忆的上下文超限策略（M-2）：
# 会话消息（近似）token 数达到 CONTEXT_SUMMARY_TRIGGER_TOKENS 时，
# 自动把较早消息摘要压缩，只保留最近 CONTEXT_KEEP_MESSAGES 条原始消息。
CONTEXT_SUMMARY_TRIGGER_TOKENS=3000
CONTEXT_KEEP_MESSAGES=6

# 长期用户画像记忆（M-3）：recall_user_memory 工具一次最多返回几条相关记忆。
LONG_TERM_MEMORY_TOP_K=5
