# 应用配置
APP_ENV=development
APP_NAME=EvidenceDesk Agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL 配置
POSTGRES_USER=evidence_desk
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=evidence_desk
POSTGRES_PORT=5433
DATABASE_URL=postgresql://evidence_desk:replace_with_a_local_password@127.0.0.1:5433/evidence_desk

# Weaviate 配置
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_URL=http://127.0.0.1:8081

# GitHub API 配置（GitHub Tool 阶段之前保持 Token 为空）
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=

# RAG Baseline（这里只登记配置，阶段 0C 不下载模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RETRIEVAL_TOP_K=5
